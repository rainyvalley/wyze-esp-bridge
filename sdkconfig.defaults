# Shared by all boards. Board specifics: sdkconfig.defaults.<target>
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# Placeholders: set your gateway's URI/token here for a hands-free install, or
# leave them and enter values on the 3-second console prompt at boot (stored in
# NVS, survives reboots and OTA updates).
CONFIG_WYZE_GATEWAY_URI="ws://192.168.1.10:8080/ws/bridge"
CONFIG_WYZE_BRIDGE_TOKEN=""
# The pairing-dongle's CH9350 front-end needs a longer post-reset settle than
# the USB 2.0 spec minimum that IDF defaults to; too short and the first root
# port resets fail on ESP32-P4 (HUB: Root port reset failed spam).
CONFIG_USB_HOST_DEBOUNCE_DELAY_MS=300
CONFIG_USB_HOST_RESET_HOLD_MS=50
CONFIG_USB_HOST_RESET_RECOVERY_MS=250
